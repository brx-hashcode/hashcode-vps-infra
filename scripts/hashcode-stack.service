# Brings the infra stack up after boot, then checks everything and reports to
# Slack (scripts/post-boot-check.sh).
#
# Restart policies already bring containers back; this is the safety net for
# the ones that exit at boot and never retry (Traefik on 2026-10-18, beaten to
# :80 by a host package), and the alert that something is still down.
#
# Install (once, as root):
#   ln -sf /home/brx/hashcode-vps-infra/scripts/hashcode-stack.service /etc/systemd/system/hashcode-stack.service
#   systemctl daemon-reload && systemctl enable hashcode-stack.service
# Logs: journalctl -u hashcode-stack -b

[Unit]
Description=Bring the hashcode stack up after boot and report to Slack
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=brx
Group=docker
WorkingDirectory=/home/brx/hashcode-vps-infra
# Let Docker finish restoring containers with restart policies first.
ExecStartPre=/bin/sleep 30
# Both files, always: the base file alone starts Traefik without its
# websecure entrypoint or certificate resolver. The leading `-` keeps a failed
# `up` from skipping the check below — that is exactly when the alert matters.
ExecStart=-/usr/bin/docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
ExecStartPost=/home/brx/hashcode-vps-infra/scripts/post-boot-check.sh
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
