# ── Infra domain (shared tooling: Grafana, Qdrant) ───────────────────────────
INFRA_DOMAIN=hashcode.org
# grafana.hashcode.org
# qdrant.hashcode.org

# ── TLS (Let's Encrypt) ───────────────────────────────────────────────────────
EMAIL=admin@hashcode.org

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=rabotka
