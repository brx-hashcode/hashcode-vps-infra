# ── Infra domain (shared tooling: Grafana, Qdrant, Vault) ────────────────────
INFRA_DOMAIN=hashcode.digital
# grafana.hashcode.digital
# qdrant.hashcode.digital
# vault.hashcode.digital

# ── TLS (Let's Encrypt) ───────────────────────────────────────────────────────
EMAIL=admin@hashcode.digital

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=rabotka
POSTGRES_PASSWORD=changeme
# databases are created per project/env (rabotka_prod, rabotka_int, rabotka_dev)

# ── PgBouncer ─────────────────────────────────────────────────────────────────
# Database entries are configured in pgbouncer/pgbouncer.ini — add one line per
# environment database. Apps connect via:
#   DATABASE_URL=postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@pgbouncer:5432/<dbname>
# Migrations must use a direct Postgres URL (bypasses PgBouncer transaction mode):
#   DIRECT_DATABASE_URL=postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@postgres:5432/<dbname>

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# ── Traefik dashboard ─────────────────────────────────────────────────────────
# Generate with: htpasswd -nb admin yourpassword
# traefik.hashcode.digital (prod)
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$...
