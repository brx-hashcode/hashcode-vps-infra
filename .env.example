# ── Infra domain (shared tooling: Grafana, Qdrant, Vault) ────────────────────
INFRA_DOMAIN=hashcode.digital
# grafana.hashcode.digital
# qdrant.hashcode.digital
# vault.hashcode.digital

# ── TLS (Let's Encrypt, DNS-01 via Cloudflare) ───────────────────────────────
EMAIL=admin@hashcode.digital
# Cloudflare API token for the ACME DNS-01 challenge.
#
# Required. Every domain here sits behind the Cloudflare proxy, so Let's
# Encrypt never reaches this box — an HTTP-01 challenge is answered by
# Cloudflare's edge, not by Traefik. That is what silently broke every renewal
# until 2026-08-22, when all fourteen certificates were found expired.
#
# Create it at Cloudflare → My Profile → API Tokens:
#   Permissions: Zone → DNS → Edit
#   Zone Resources: include only the zones served here
#
# NOT the Global API Key. That one can do anything to the account, and this
# value lives in a container's environment.
CF_DNS_API_TOKEN=changeme

# ── Qdrant ───────────────────────────────────────────────────────────────────
# SERVER-side API key. Qdrant enforces nothing when this is empty — it does not
# warn, it simply serves every request, which is how the production vector store
# ended up readable from the internet on 2026-08-22.
#
# Must MATCH the QDRANT_API_KEY the backend reads from Vault, which is the value
# its client already sends. A mismatch turns every backend query into a 401.
QDRANT_API_KEY=changeme

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=rabotka
POSTGRES_PASSWORD=changeme
# databases are created per project/env (rabotka_prod, rabotka_int, rabotka_dev)

# ── PgBouncer ─────────────────────────────────────────────────────────────────
# Database name(s) PgBouncer accepts — comma-separated for multiple projects.
# Apps connect to: postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@pgbouncer:5432/$PGBOUNCER_DATABASE
# Migrations must use the direct Postgres URL (bypasses PgBouncer transaction mode):
#   postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@postgres:5432/<db>
PGBOUNCER_DATABASE=rabotka
# Max simultaneous client connections across all pools
PGBOUNCER_MAX_CLIENT_CONN=200
# Server-side connections per (user, database, pool) tuple
PGBOUNCER_DEFAULT_POOL_SIZE=20

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# ── Traefik dashboard ─────────────────────────────────────────────────────────
# Generate with: htpasswd -nb admin yourpassword
# traefik.hashcode.digital (prod)
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$...
