# ── Infra domain (shared tooling: Grafana, Qdrant, Vault) ────────────────────
INFRA_DOMAIN=hashcode.org
# grafana.hashcode.org
# qdrant.hashcode.org
# vault.hashcode.org

# ── TLS (Let's Encrypt) ───────────────────────────────────────────────────────
EMAIL=admin@hashcode.org

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=rabotka
POSTGRES_PASSWORD=changeme
# databases are created per project/env (rabotka_prod, rabotka_int, rabotka_dev)

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# ── SonarQube ─────────────────────────────────────────────────────────────────
# Create DB and user before first boot:
#   docker exec -it postgres psql -U $POSTGRES_USER -c "CREATE DATABASE sonarqube;"
#   docker exec -it postgres psql -U $POSTGRES_USER -c "CREATE USER sonarqube WITH PASSWORD 'changeme';"
#   docker exec -it postgres psql -U $POSTGRES_USER -c "GRANT ALL PRIVILEGES ON DATABASE sonarqube TO sonarqube;"
SONARQUBE_DB_NAME=sonarqube
SONARQUBE_DB_USER=sonarqube
SONARQUBE_DB_PASSWORD=changeme

# ── Traefik dashboard ─────────────────────────────────────────────────────────
# Generate with: htpasswd -nb admin yourpassword
# traefik.hashcode.org (prod)
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$...
